program tdd_long_string_const_no_truncation;
{ Regression: string constants >512 chars were silently truncated by a fixed
  512-byte escape buffer (and 1024-byte rodata buffer) in codegen. They are now
  sized from the source length. The 600th char 'Z' must survive. }
const S = '';
begin
  writeln(Length(S));
  writeln(S[513]);
  writeln(S[600]);
end.
